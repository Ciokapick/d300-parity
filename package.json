{
  "name": "d300-parity",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Reconstrucție neoficială pe web a formularului ANAF D300, cu paritate dovedită față de PDF-ul original",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "gen:fields": "node harness/gen-fields.mjs",
    "gen:rows": "node harness/gen-rows.mjs",
    "gen:presets": "node harness/gen-presets.mjs",
    "golden": "node harness/oracle/golden.mjs",
    "golden:check": "node harness/oracle/golden.mjs --check",
    "parity": "npx tsx harness/parity/run.mjs",
    "parity:regen": "node harness/oracle/generate.mjs --seed 1 --count 300 --out cases/gen && npx tsx harness/parity/run.mjs"
  },
  "dependencies": {
    "pinia": "^4.0.3",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.12.0",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.3.0",
    "vue-tsc": "^3.3.11"
  }
}
